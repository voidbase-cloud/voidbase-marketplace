{
  "name": "voidbase-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "bunx --bun vite build",
    "check": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.workflows.json",
    "preview": "bun .voidbase/main.ts --http 127.0.0.1:8090",
    "registry:check": "bun scripts/registry.ts check",
    "submission:validate": "bun scripts/validate.ts",
    "submission:approve": "bun scripts/approve.ts",
    "deploy": "bunx voidbase sync --name voidbase-marketplace --domain marketplace.voidbase.cloud",
    "registry:index": "bun scripts/registry-index.ts",
    "plugin:bundle": "bun scripts/bundle.ts",
    "theme:publish": "bun scripts/theme.ts",
    "test": "bun test/publish.ts"
  },
  "dependencies": {
    "@void/react": "^0.10.13",
    "@voidbase-cloud/voidbase": "0.9.0-beta.47",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "sass": "^1.104.0",
    "vite": "^8.2.2",
    "void": "^0.10.13"
  }
}
